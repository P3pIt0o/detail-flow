# ============================================================================
#  VARIABLES D'ENVIRONNEMENT
# ============================================================================
#  Copier ce fichier en ".env" puis renseigner les valeurs.
#  Ne JAMAIS committer le fichier .env (il contient des secrets).
# ============================================================================

# ---------------------------------------------------------------------------
#  BASE DE DONNÉES (PostgreSQL) — requis dès la Phase 2
# ---------------------------------------------------------------------------
# Exemple Neon : postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=""

# ---------------------------------------------------------------------------
#  SITE
# ---------------------------------------------------------------------------
# URL publique de production (sans slash final). Sert au SEO, sitemap, emails.
NEXT_PUBLIC_SITE_URL="https://www.detailflow.fr"

# ---------------------------------------------------------------------------
#  MULTI-TENANT (SaaS) — requis pour les sous-domaines par entreprise
# ---------------------------------------------------------------------------
# Domaine racine servant à construire les sous-domaines de chaque entreprise.
# Exemple : "detailflow.fr" → chaque entreprise obtient "monentreprise.detailflow.fr".
# Laisser vide en local/preview : l'app retombe alors sur "/?tenant=slug".
NEXT_PUBLIC_ROOT_DOMAIN="detailflow.fr"

# Liste d'emails (séparés par des virgules) promus automatiquement super-admin
# à leur première connexion. Sert à amorcer l'accès à l'espace /super-admin.
# Exemple : "fondateur@detailflow.fr,associe@detailflow.fr"
SUPER_ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
#  AUTHENTIFICATION (Better Auth)
# ---------------------------------------------------------------------------
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ---------------------------------------------------------------------------
#  EMAILS (envoi transactionnel) — Phase 2+
# ---------------------------------------------------------------------------
# Fournisseur recommandé : Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="DetailFlow <contact@detailflow.fr>"

# ---------------------------------------------------------------------------
#  CALCUL DES FRAIS DE DÉPLACEMENT (Phase 2) — géocodage & distance routière
# ---------------------------------------------------------------------------
# Clé Google Maps (Distance Matrix + Geocoding) OU alternative (Mapbox/ORS)
GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------------------
#  PAIEMENTS (Phase 4) — activés plus tard, architecture déjà prête
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
